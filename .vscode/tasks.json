/**
 * 在 VS Code 里跑 Android 的整套动作，全部走任务（Terminal → Run Task）。
 *
 * 为什么不用 Android 扩展：VS Code 上那些 Android 扩展对「编译 + 模拟器 + adb」这条链
 * 支持得支离破碎（多数已经停止维护），而这三件事本质上就是命令行。把它做成任务，
 * 点一下就跑，输出还能直接看，比装三个扩展稳。
 *
 * 用法：Ctrl+Shift+P → "Tasks: Run Task" → 选一个。
 */
{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}",
    "env": {
      "JAVA_HOME": "D:/Java",
      "ANDROID_HOME": "C:/Android/sdk",
      "ANDROID_SDK_ROOT": "C:/Android/sdk"
    }
  },
  "presentation": {
    "reveal": "always",
    "panel": "dedicated",
    "clear": true
  },
  "tasks": [
    {
      "label": "⑪ 打开手机窗口（有界面，一键）",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/phone.ps1",
      "problemMatcher": []
    },
    {
      "label": "① 构建 APK（arm64，给真机）",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/use-engine.ps1 -Abi arm64; cd android; .\\gradlew.bat --no-daemon assembleDebug",
      "problemMatcher": []
    },
    {
      "label": "② 构建 APK（x86_64，给模拟器）",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/use-engine.ps1 -Abi amd64; cd android; .\\gradlew.bat --no-daemon assembleDebug",
      "problemMatcher": []
    },
    {
      "label": "③ 启动模拟器（无窗口，端口 5554）",
      "type": "shell",
      "command": "${env:ANDROID_HOME}/emulator/emulator.exe -avd dshpocket -no-window -no-audio -no-boot-anim -gpu swiftshader_indirect -port 5554",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "④ 等模拟器起来",
      "type": "shell",
      "command": "adb -s emulator-5554 wait-for-device; while ((adb -s emulator-5554 shell getprop sys.boot_completed).Trim() -ne '1') { Start-Sleep 3 }; echo BOOTED",
      "problemMatcher": []
    },
    {
      "label": "⑤ 安装并启动 App",
      "type": "shell",
      "command": "adb -s emulator-5554 install -r android/app/build/outputs/apk/debug/app-debug.apk; adb -s emulator-5554 shell am force-stop dev.dshpocket.app; adb -s emulator-5554 shell am start -n dev.dshpocket.app/.MainActivity",
      "problemMatcher": []
    },
    {
      "label": "⑥ 看引擎日志（隧道/登录）",
      "type": "shell",
      "command": "adb -s emulator-5554 logcat -v time -s DshPocket:* Tailscale/gojni:* AndroidRuntime:E",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "⑦ 截图到 shots/",
      "type": "shell",
      "command": "New-Item -ItemType Directory -Force shots | Out-Null; adb -s emulator-5554 exec-out screencap -p > shots/$(Get-Date -Format HHmmss).png; dir shots",
      "problemMatcher": []
    },
    {
      "label": "⑧ 后端测试（插件 + 中继 + 手机端自检）",
      "type": "shell",
      "command": "cd plugin; node --test \"test/**/*.test.mjs\"; node tools/pwa-smoke.mjs; cd ../relay; node --test \"test/**/*.test.mjs\"",
      "problemMatcher": []
    },
    {
      "label": "⑨ 隧道模拟（真中继 + 手机侧帧）",
      "type": "shell",
      "command": "cd plugin; node tools/tunnel-sim.mjs --dsh-port 3080 --token $env:POCKET_TOKEN",
      "problemMatcher": []
    },
    {
      "label": "⑩ 一键：模拟器全流程（构建→启动→装机→日志）",
      "dependsOrder": "sequence",
      "dependsOn": ["② 构建 APK（x86_64，给模拟器）", "③ 启动模拟器（无窗口，端口 5554）", "④ 等模拟器起来", "⑤ 安装并启动 App", "⑥ 看引擎日志（隧道/登录）"],
      "problemMatcher": []
    },
    {
      "label": "⑫ 关掉模拟器",
      "type": "shell",
      "command": "adb -s emulator-5554 emu kill",
      "problemMatcher": []
    }
  ]
}
