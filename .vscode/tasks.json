/**
 * VS Code 任务：构建 / 模拟器 / 装机 / 日志 / 测试 / 公网隧道。
 *
 * 用法：Ctrl+Shift+P → "Tasks: Run Task"。
 * 需要的前提都在 docs/VSCODE.md 里：JDK 17、Android SDK（platform-tools、emulator、android-34）。
 */
{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}",
    "env": {
      "JAVA_HOME": "D:/Java",
      "ANDROID_HOME": "C:/Android/sdk",
      "ANDROID_SDK_ROOT": "C:/Android/sdk"
    }
  },
  "presentation": {
    "reveal": "always",
    "panel": "dedicated",
    "clear": false
  },
  "tasks": [
    {
      "label": "① 构建 APK",
      "type": "shell",
      "command": "cd android; .\\gradlew.bat --no-daemon assembleDebug",
      "problemMatcher": []
    },
    {
      "label": "② 启动模拟器（无窗口）",
      "type": "shell",
      "command": "${env:ANDROID_HOME}/emulator/emulator.exe -avd dshpocket -no-window -no-audio -no-boot-anim -gpu swiftshader_indirect -port 5554",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "③ 等模拟器起来",
      "type": "shell",
      "command": "adb -s emulator-5554 wait-for-device; while ((adb -s emulator-5554 shell getprop sys.boot_completed).Trim() -ne '1') { Start-Sleep 3 }; echo BOOTED",
      "problemMatcher": []
    },
    {
      "label": "④ 安装并启动 App",
      "type": "shell",
      "command": "adb -s emulator-5554 install -r android/app/build/outputs/apk/debug/app-debug.apk; adb -s emulator-5554 shell am force-stop dev.dshpocket.app; adb -s emulator-5554 shell am start -n dev.dshpocket.app/.MainActivity",
      "problemMatcher": []
    },
    {
      "label": "⑤ 看日志",
      "type": "shell",
      "command": "adb -s emulator-5554 logcat -v time -s DshPocket:* AndroidRuntime:E",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "⑥ 截图到 shots/",
      "type": "shell",
      "command": "New-Item -ItemType Directory -Force shots | Out-Null; adb -s emulator-5554 exec-out screencap -p > shots/$(Get-Date -Format HHmmss).png; dir shots",
      "problemMatcher": []
    },
    {
      "label": "⑦ 后端测试（插件 + 中继 + 手机端自检）",
      "type": "shell",
      "command": "cd plugin; node --test \"test/**/*.test.mjs\"; node tools/pwa-smoke.mjs; cd ../relay; node --test \"test/**/*.test.mjs\"",
      "problemMatcher": []
    },
    {
      "label": "⑧ 中继模拟（真中继 + 手机侧帧）",
      "type": "shell",
      "command": "cd plugin; node tools/tunnel-sim.mjs --dsh-port 3080 --token $env:POCKET_TOKEN",
      "problemMatcher": []
    },
    {
      "label": "⑨ 公网隧道（在外面用）",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\outside-tunnel.ps1",
      "problemMatcher": []
    },
    {
      "label": "⑩ 公网隧道的当前地址",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\outside-tunnel.ps1 -Status",
      "problemMatcher": []
    },
    {
      "label": "⑪ 一键：模拟器全流程",
      "dependsOrder": "sequence",
      "dependsOn": ["① 构建 APK", "② 启动模拟器（无窗口）", "③ 等模拟器起来", "④ 安装并启动 App", "⑤ 看日志"],
      "problemMatcher": []
    }
  ]
}